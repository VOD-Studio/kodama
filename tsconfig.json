{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "typeRoots": ["./packages/kodama-sdk/node_modules/@types"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.mts", "tests/**/*.mts"],
  "exclude": [
    "**/node_modules",
    "tests/consumers/tanstack-start/**",
    "tests/consumers/node-embed/**",
    "tests/bench/**",
    "tests/parity/node-cjs.mts",
    "tests/parity/web-wasm.mts"
  ]
}
