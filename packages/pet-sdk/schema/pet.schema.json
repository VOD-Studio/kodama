            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "worn": {
          "$ref": "#/$defs/Outfit",
          "description": "身上的装扮。"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pet wire protocol",
  "x-capabilities": {
    "capabilities": [
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": true,
        "op": "birth",
        "summary": "由出生输入派生个体身份、稀有度、物种与基因"
      },
      {
        "errors": [
          "bad_input",
          "dead",
          "no_food",
          "no_medicine",
          "not_sick",
          "too_tired",
          "time_backwards",
          "unsupported_rules",
          "not_eligible",
          "not_owned",
          "incompatible_item",
          "on_expedition",
          "no_expedition",
          "still_away",
          "daily_limit",
          "unwell"
        ],
        "mutates_state": true,
        "op": "act",
        "summary": "对宠物执行喂食、休息、玩耍、治疗、等待、进化、穿脱装扮或探险(出发、领取、召回),按逻辑时间结算病程;升级时解锁装扮"
      },
      {
        "errors": [
          "bad_input",
          "dead",
          "invalid_reward",
          "time_backwards",
          "unsupported_rules"
        ],
        "mutates_state": true,
        "op": "grant",
        "summary": "发放经服务裁决后的奖励(经验、食物、药品、主题倾向);核心只校验单次上限"
      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "evolution_options",
        "summary": "列出当前阶段的进化分支,以及每个分支的缺项说明"
      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "frame",
        "summary": "将姿态与呈现时钟合成为字符单元网格"
      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "sprite",
        "summary": "将姿态、成长阶段与呈现时钟合成为像素画调色板与网格"
      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "verify_birth",
        "summary": "核验出生证书的来源签名、承诺揭示与结果重算"
      },
      {
        "errors": [],
        "mutates_state": false,
        "op": "capabilities",
        "summary": "列出当前实现的全部能力与错误分类"
      }
    ],
    "rules_version": 1
  },
  "x-op-results": {
    "act": "OutcomeResult",
    "birth": "BirthResult",
    "capabilities": "CapabilityCatalogResult",
    "evolution_options": "EvolutionOptionsResult",
    "frame": "FrameResult",
    "grant": "OutcomeResult",
    "sprite": "PixelsResult",
    "verify_birth": "VerdictResult"
  }
}
