        "topic",
        "tier",
        "departed_at",
        "back_at"
      ],
      "type": "object"
    },
    "Verdict": {
      "oneOf": [
        {
          "enum": [
            "valid",
            "unsupported_rules",
            "bad_encoding",
            "commit_signature",
            "commitment_mismatch",
            "accept_signature",
            "result_mismatch"
          ],
          "type": "string"
        },
        {
          "const": "unknown_key",
          "description": "密钥集中没有证书所标明的 kid。",
          "type": "string"
        },
        {
          "const": "key_not_valid",
          "description": "签发时间不在该密钥的有效窗口内。",
          "type": "string"
        },
        {
          "const": "key_revoked",
          "description": "签发时间不早于该密钥的撤销时间。",
          "type": "string"
        }
      ]
    },
    "VerdictResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Wardrobe": {
      "properties": {
        "owned": {
          "description": "拥有的物品，按目录顺序。",
