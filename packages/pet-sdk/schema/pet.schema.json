          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "medicine": {
          "description": "药品,单次至多 3。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "topic": {
          "description": "接入方映射后的主题标签,至多 32 字节;缺省则不记录主题。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "exp",
        "food",
        "medicine"
      ],
      "type": "object"
    },
    "Slot": {
      "enum": [
        "head",
        "face",
        "body",
        "back",
        "background"
      ],
      "type": "string"
    },
    "Souvenir": {
      "description": "一件见闻：在哪个主题的探险里得到的什么东西。约十六分之一会是闪亮的。",
      "properties": {
