          "description": "什么时候可以领取。",
          "type": "string"
        },
        "departed_at": {
          "type": "string"
        },
        "id": {
          "description": "探险编号，即出发那次请求的标识；收藏品由它复算。",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
