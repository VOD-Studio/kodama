    },
    "Tier": {
      "oneOf": [
        {
          "const": "short",
          "description": "4 小时。",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "12 小时。",
          "type": "string"
        },
        {
          "const": "long",
          "description": "24 小时。",
          "type": "string"
        }
      ]
    },
    "TopicCount": {
      "description": "主题倾向:接入方映射后的主题标签及累计次数。",
