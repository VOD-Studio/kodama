          "type": "string"
        }
      },
      "required": [
        "topic",
        "count"
      ],
      "type": "object"
    },
    "Travels": {
      "description": "探险的全部状态：进行中的一次、当天出发次数、收藏册。空时不写出，旧存档保持原样。",
      "properties": {
        "album": {
          "description": "每种见闻累计得到的件数，顺序同 `KEEPSAKES`。",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "day": {
          "description": "出发次数所属的逻辑日（逻辑时间 / 1440）与次数。",
          "type": "string"
        },
        "departures": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "recent": {
          "description": "最近得到的见闻，新的在后。",
          "items": {
            "$ref": "#/$defs/Souvenir"
          },
          "type": "array"
        },
