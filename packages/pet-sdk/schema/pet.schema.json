          "type": "string"
        },
        "public_key": {
          "description": "Ed25519 公钥,64 位十六进制。",
          "type": "string"
        },
        "revoked_at": {
          "default": null,
          "description": "撤销时间:自该时间起(含)签发的证书无效,之前的证书不受影响。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
