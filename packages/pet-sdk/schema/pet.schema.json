        },
        "face": {
          "anyOf": [
            {
              "$ref": "#/$defs/Item"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/Item"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
