    "Phase": {
      "enum": [
        "healthy",
        "warned",
        "sick",
        "dead"
      ],
      "type": "string"
    },
    "PixelInput": {
      "description": "`sprite` 命令的输入。画布不小于 56×36 时任何外形与姿态都不会被裁切（最大的是展翅的成年形态）；\n待机时会在画布里来回走动，需要更宽的画布才走得开，例如 96×40。画布更小时以身体中线居中裁切。",
      "properties": {
        "genes": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "h": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "lineage": {
          "default": [],
          "description": "进化分支，按发生顺序（即宠物的 `growth.lineage`）。决定少年与成年的具体外形。",
          "items": {
            "$ref": "#/$defs/Branch"
          },
          "type": "array"
        },
        "outfit": {
          "$ref": "#/$defs/Outfit",
          "default": {},
          "description": "穿戴的装扮（即宠物的 `wardrobe.worn`）。不适合这个身体结构的物品不画。"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "stage": {
          "description": "成长阶段：0 幼体、1 少年、2 成年。给出 `lineage` 时以进化记录为准。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "t": {
          "type": "string"
        },
        "w": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "species",
        "genes",
        "pose",
        "stage",
        "w",
        "h",
        "t"
      ],
      "type": "object"
    },
    "Pixels": {
      "description": "像素网格。`rows` 的每个字符是 `palette` 的键,`.` 表示透明。",
      "properties": {
        "h": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "palette": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "键为单个字符,值为 `#rrggbb`。",
          "type": "object"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "w": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "w",
        "h",
        "rows",
        "palette"
      ],
      "type": "object"
    },
    "PixelsResult": {
      "description": "成功响应信封。",
