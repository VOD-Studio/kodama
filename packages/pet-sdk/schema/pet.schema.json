{
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "enum": [
            "feed",
            "rest",
            "play",
            "heal",
            "wait"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "进化到指定分支。永不自动发生,需要主人选择。",
          "properties": {
            "evolve": {
              "properties": {
                "branch": {
                  "$ref": "#/$defs/Branch"
                }
              },
              "required": [
                "branch"
              ],
              "type": "object"
            }
          },
          "required": [
            "evolve"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "穿上拥有的物品，替换同一槽位上的物品。不改变任何数值。",
          "properties": {
            "equip": {
              "properties": {
                "item": {
                  "$ref": "#/$defs/Item"
                }
              },
              "required": [
                "item"
              ],
              "type": "object"
            }
          },
          "required": [
            "equip"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "脱下一个槽位上的物品；物品仍然拥有。",
          "properties": {
            "unequip": {
              "properties": {
                "slot": {
                  "$ref": "#/$defs/Slot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "unequip"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "带着一个主题去探险（4、12 或 24 小时），出发消耗食物。",
          "properties": {
            "depart": {
              "properties": {
                "tier": {
                  "$ref": "#/$defs/Tier"
                },
                "topic": {
                  "type": "string"
                }
              },
              "required": [
                "topic",
                "tier"
              ],
              "type": "object"
            }
          },
          "required": [
            "depart"
          ],
          "type": "object"
        },
        {
          "const": "return",
          "description": "探险到时间后领取：少量经验与一件见闻。",
          "type": "string"
        },
        {
          "const": "recall",
          "description": "领取前召回：返还出发消耗的食物，没有产出。",
          "type": "string"
        }
      ]
    },
    "Birth": {
      "properties": {
        "genes": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "pet": {
          "$ref": "#/$defs/Pet"
        },
        "rarity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rarity",
        "species",
        "genes",
        "pet"
      ],
      "type": "object"
    },
    "BirthInput": {
      "properties": {
        "born_at": {
          "type": "string"
        },
        "client_seed": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "server_seed": {
          "description": "服务端承诺并揭示的随机材料,64 位十六进制。",
          "type": "string"
        },
        "world": {
          "type": "string"
        }
      },
      "required": [
        "world",
        "request_id",
        "server_seed",
        "client_seed",
        "born_at"
      ],
      "type": "object"
    },
    "BirthResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Birth"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Branch": {
      "oneOf": [
        {
          "enum": [
            "curious",
            "gentle",
            "steady",
            "sage",
            "guardian",
            "wanderer"
          ],
          "type": "string"
        },
        {
          "const": "radiant",
          "description": "后天罕见形态:不改变出生稀有度,只记录在 acquired_rarity。",
          "type": "string"
        }
      ]
    },
    "BranchOption": {
      "properties": {
        "branch": {
          "$ref": "#/$defs/Branch"
        },
        "eligible": {
          "type": "boolean"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/Missing"
          },
          "type": "array"
        },
        "to_stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "branch",
        "to_stage",
        "eligible",
        "missing"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "一项可调用能力。能力发现、CLI 帮助与文档都由这张表产出,新增命令必须在此登记。",
      "properties": {
        "errors": {
          "description": "该能力可能返回的业务错误分类。",
          "items": {
            "$ref": "#/$defs/ErrorCode"
          },
          "type": "array"
        },
        "mutates_state": {
          "description": "是否产生需要持久化的状态变化(调用方负责提交,核心不写存储)。",
          "type": "boolean"
        },
        "op": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "summary",
        "mutates_state",
        "errors"
      ],
      "type": "object"
    },
    "CapabilityCatalog": {
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "rules_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rules_version",
        "capabilities"
      ],
      "type": "object"
    },
    "CapabilityCatalogResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/CapabilityCatalog"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Certificate": {
      "properties": {
        "accept_sig": {
          "description": "服务端承诺在先、接受客户端随机在后的签名收据。",
          "type": "string"
        },
        "client_seed": {
          "type": "string"
        },
        "commit_sig": {
          "type": "string"
        },
        "commitment": {
          "description": "先于客户端随机材料公布。",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "id": {
          "type": "string"
        },
        "rarity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "server_seed": {
          "type": "string"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "context",
        "commitment",
        "commit_sig",
        "client_seed",
        "accept_sig",
        "server_seed",
        "id",
        "rarity",
        "species"
      ],
      "type": "object"
    },
    "Charset": {
      "oneOf": [
        {
          "enum": [
            "ascii",
            "unicode"
          ],
          "type": "string"
        },
        {
          "const": "blocks",
          "description": "半格像素画：每个字符格显示上下两个像素（上半格前景色、下半格背景色），与 `sprite` 是同一套外形与动作。\n需要 UTF-8 与 256 色；高度不小于 10 行时完整显示幼体，约 20 行显示带翅膀的成年形态。",
          "type": "string"
        }
      ]
    },
    "Command": {
      "description": "线上命令:`op` 为判别字段。",
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "capabilities",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "now": {
              "type": "string"
            },
            "op": {
              "const": "grant",
              "type": "string"
            },
            "pet": {
              "$ref": "#/$defs/Pet"
            },
            "request_id": {
              "type": "string"
            },
            "reward": {
              "$ref": "#/$defs/Reward"
            }
          },
          "required": [
            "op",
            "pet",
            "reward",
            "now",
            "request_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "evolution_options",
              "type": "string"
            },
            "pet": {
              "$ref": "#/$defs/Pet"
            }
          },
          "required": [
            "op",
            "pet"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/BirthInput",
          "properties": {
            "op": {
              "const": "birth",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/FrameInput",
          "properties": {
            "op": {
              "const": "frame",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PixelInput",
          "properties": {
            "op": {
              "const": "sprite",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "certificate": {
              "$ref": "#/$defs/Certificate"
            },
            "issuer_keys": {
              "items": {
                "$ref": "#/$defs/IssuerKey"
              },
              "type": "array"
            },
            "op": {
              "const": "verify_birth",
              "type": "string"
            }
          },
          "required": [
            "op",
            "certificate",
            "issuer_keys"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "$ref": "#/$defs/Action"
            },
            "now": {
              "type": "string"
            },
            "op": {
              "const": "act",
              "type": "string"
            },
            "pet": {
              "$ref": "#/$defs/Pet"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "pet",
            "action",
            "now",
            "request_id"
          ],
          "type": "object"
        }
      ]
    },
    "Context": {
      "description": "本次领取固定的上下文:世界、发行者、请求、资格与规则摘要。",
      "properties": {
        "eligibility": {
          "description": "领取资格摘要,不含账号标识或原始活动。",
          "type": "string"
        },
        "issued_at": {
          "description": "签发方声称的签发时间(逻辑时间)。它由签名保护但由签发方自报,\n所以撤销被盗密钥时应取最早可能的泄露时间,见 docs/design/birth-protocol.md。",
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "kid": {
          "description": "签名密钥标识。验证方按它在密钥集中选择公钥,从而支持轮换。",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "rules_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "world": {
          "type": "string"
        }
      },
      "required": [
        "world",
        "issuer",
        "kid",
        "request_id",
        "eligibility",
        "rules_version",
        "issued_at"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "description": "失败响应信封。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "业务错误分类。调用方按此分支处理,`message` 仅供人读。",
      "oneOf": [
        {
          "const": "bad_input",
          "description": "输入无法解析或字段非法。",
          "type": "string"
        },
        {
          "const": "dead",
          "description": "宠物已死亡,任何照料动作都被拒绝。",
          "type": "string"
        },
        {
          "const": "no_food",
          "description": "库存没有食物。",
          "type": "string"
        },
        {
          "const": "no_medicine",
          "description": "库存没有药品。",
          "type": "string"
        },
        {
          "const": "not_sick",
          "description": "宠物未处于生病阶段,无需治疗。",
          "type": "string"
        },
        {
          "const": "too_tired",
          "description": "精力不足以玩耍。",
          "type": "string"
        },
        {
          "const": "time_backwards",
          "description": "`now` 早于宠物记录的 `last_tick`。",
          "type": "string"
        },
        {
          "const": "unsupported_rules",
          "description": "宠物保存时的规则版本不被当前实现支持,拒绝结算而不是猜测迁移。",
          "type": "string"
        },
        {
          "const": "not_eligible",
          "description": "进化条件未满足;缺项说明用 evolution_options 查询。",
          "type": "string"
        },
        {
          "const": "invalid_reward",
          "description": "奖励超出单次允许的范围。",
          "type": "string"
        },
        {
          "const": "not_owned",
          "description": "宠物没有这件物品。",
          "type": "string"
        },
        {
          "const": "incompatible_item",
          "description": "物品不适合宠物的身体结构。",
          "type": "string"
        },
        {
          "const": "on_expedition",
          "description": "宠物正在探险，要等它回来。",
          "type": "string"
        },
        {
          "const": "no_expedition",
          "description": "宠物没有在探险。",
          "type": "string"
        },
        {
          "const": "still_away",
          "description": "探险还没到时间。",
          "type": "string"
        },
        {
          "const": "daily_limit",
          "description": "当天的次数已用完。",
          "type": "string"
        },
        {
          "const": "unwell",
          "description": "生病时不能出发。",
          "type": "string"
        }
      ]
    },
    "EvolutionOptions": {
      "properties": {
        "level": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/BranchOption"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "stage",
        "level",
        "options"
      ],
      "type": "object"
    },
    "EvolutionOptionsResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/EvolutionOptions"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Frame": {
      "properties": {
        "bg": {
          "description": "与 rows 逐字符对应的背景 256 色索引；0 表示不设背景。只有 `blocks` 画风使用。",
          "items": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "colors": {
          "description": "与 rows 逐字符对应的 256 色索引;0 表示不着色。",
          "items": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "h": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "w": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "w",
        "h",
        "rows",
        "colors",
        "bg"
      ],
      "type": "object"
    },
    "FrameInput": {
      "description": "帧合成输入:投影字段 + 呈现时钟。呈现时钟只影响动作相位,不影响任何养成结果。",
      "properties": {
        "charset": {
          "$ref": "#/$defs/Charset"
        },
        "genes": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "h": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "lineage": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Branch"
          },
          "type": "array"
        },
        "outfit": {
          "$ref": "#/$defs/Outfit",
          "default": {},
          "description": "穿戴的装扮；只有 `blocks` 画风画出来。"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "stage": {
          "default": 0,
          "description": "成长阶段与进化记录，含义与 `sprite` 相同；只有 `blocks` 画风按外形绘制。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "t": {
          "type": "string"
        },
        "w": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "species",
        "genes",
        "pose",
        "charset",
        "w",
        "h",
        "t"
      ],
      "type": "object"
    },
    "FrameResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Frame"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Growth": {
      "description": "成长状态。所有字段有默认值,保证没有该结构的旧存档仍可加载。",
      "properties": {
        "acquired_rarity": {
          "description": "后天罕见形态:0 无,1 为 Radiant。与出生稀有度无关,出生档位不变。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "base_traits": {
          "description": "出生底色,由基因决定,创建后不变。当前性格最多偏离底色 +200。",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "drift_day": {
          "description": "性格漂移预算所属的天(逻辑时间 / 1440)。",
          "type": "string"
        },
        "drift_used": {
          "description": "当天各维度已使用的漂移点数。",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "exp": {
          "description": "累计经验,至多 1500。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lineage": {
          "description": "已选择的进化分支,按发生顺序。出生身份与基因不随进化改变。",
          "items": {
            "$ref": "#/$defs/Branch"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "topics": {
          "description": "主题倾向,至多 8 项。",
          "items": {
            "$ref": "#/$defs/TopicCount"
          },
          "type": "array"
        },
        "traits": {
          "description": "当前性格:好奇、亲和、沉稳,各 0 到 1000。",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "exp",
        "stage",
        "lineage",
