    "Pet": {
      "properties": {
        "energy": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "energy_rem": {
          "default": 0,
          "description": "精力衰减的余数刻度。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "food": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "growth": {
          "$ref": "#/$defs/Growth",
          "default": {
            "acquired_rarity": 0,
            "base_traits": [
              500,
              500,
              500
            ],
            "drift_day": "0",
            "drift_used": [
              0,
              0,
              0
            ],
            "exp": 0,
            "lineage": [],
            "stage": "baby",
            "topics": [],
            "traits": [
              500,
              500,
              500
            ]
          },
          "description": "成长状态:经验、阶段、性格、主题倾向。缺省为初始值,兼容没有该字段的旧存档。"
        },
        "id": {
          "type": "string"
        },
        "last_request": {
          "type": "string"
        },
        "last_tick": {
          "type": "string"
        },
        "medicine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "neglect": {
          "description": "持续失养的逻辑时间,决定预警、生病与死亡。",
          "type": "string"
        },
        "rules_version": {
          "default": 1,
          "description": "个体出生时所用的规则版本。缺省为 1，兼容该字段出现之前保存的个体。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "satiety": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "satiety_rem": {
          "default": 0,
          "description": "饱食衰减的余数刻度,保证结算频率不影响总衰减量。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "species": {
          "description": "物种，出生时确定；装备时据此检查身体结构。本字段之前出生的个体没有记录。",
