{
  "name": "@violetjs/pet",
  "version": "0.2.0",
  "description": "Electronic pet SDK for the web and Node: deterministic WebAssembly rules core, typed commands and terminal embedding.",
  "keywords": [
    "pet",
    "virtual-pet",
    "electronic-pet",
    "webassembly",
    "wasm",
    "deterministic",
    "terminal"
  ],
  "homepage": "https://github.com/VOD-Studio/kodama/tree/main/packages/pet-sdk#readme",
  "bugs": {
    "url": "https://github.com/VOD-Studio/kodama/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VOD-Studio/kodama.git",
    "directory": "packages/pet-sdk"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "docs",
    "schema"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/pet.schema.json",
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "default": "./dist/terminal.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./wasm": "./dist/pet_wasm_bg.wasm"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "ajv": "^8",
    "json-schema-to-typescript": "^16",
    "typescript": "^7"
  }
}
